# FloodCast Radar backend - copy to `.env` and fill in. Never commit `.env`.

# ---- Django -------------------------------------------------------------
# Generate one: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# True for local development only. Production: False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# On Heroku *.herokuapp.com is allowed automatically; add a custom domain here.

# ---- Database -----------------------------------------------------------
# Empty: local SQLite (db.sqlite3). On Heroku the Postgres add-on sets
# DATABASE_URL for you - do not set it by hand.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---- Production hardening (optional, Heroku) ---------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600

# Browser origins allowed to call /api/ directly (only needed when the
# frontend uses NEXT_PUBLIC_API_BASE; the FLOODWATCH_API_URL proxy is same-origin).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Origins allowed to send authenticated POSTs (the staff "update" button).
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- NASA Earthdata -----------------------------------------------------
# Only used by an external pipeline you configure below. The backend itself
# never downloads satellite imagery.
EARTHDATA_TOKEN=

# ---- Data updates -------------------------------------------------------
# Processed bundle to import: a web_data/ folder or a .zip of one.
FLOODWATCH_WEB_DATA=web_data
# Optional: download the bundle from here first (e.g. a GitHub Actions release asset).
FLOODWATCH_WEB_DATA_URL=
# Optional: command that runs the processing pipeline and writes FLOODWATCH_WEB_DATA.
FLOODWATCH_PIPELINE_COMMAND=
FLOODWATCH_PIPELINE_TIMEOUT_S=3600

# In-process daily scheduler (hackathon option). Use cron in production.
FLOODWATCH_SCHEDULER=False
FLOODWATCH_SCHEDULE_HOUR=6
FLOODWATCH_SCHEDULE_MINUTE=0

# ---- Alert thresholds (percent of the observed area) --------------------
ALERT_ORANGE_PCT=10
ALERT_RED_PCT=25
ALERT_RISE_PP=10
ALERT_MIN_COVERAGE_PCT=50
ALERT_CLOSE_PCT=5

# ---- E-mail flood notifications -------------------------------------------
# Leave EMAIL_HOST empty to print e-mails to the server console (demo mode).
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Public URL of the website (the Next.js frontend). Used for links in e-mails,
# and automatically trusted for CSRF/CORS - on Heroku set this to your
# frontend URL, e.g. https://floodcast-radar.vercel.app
FLOODWATCH_SITE_URL=http://localhost:3000
# E-mail subscribers automatically after each successful data import.
FLOODWATCH_AUTO_NOTIFY=True
SUBSCRIBE_RATE=20/hour

# ---- BMD field portal ------------------------------------------------------
# True: officers cannot file reports until an admin verifies them.
BMD_REQUIRE_VERIFICATION=False
BMD_AUTH_RATE=30/hour
