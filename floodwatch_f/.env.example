# FloodCast Radar - environment
#
# Copy to `.env.local` to override. With no env file the app reads the live
# Django backend on Heroku (https://floodcastradar-edd2e71135a9.herokuapp.com),
# so a hosted deploy needs no env vars at all. Set FLOODWATCH_DEMO=true to use the
# bundled demo data in public/data/ instead (no backend needed).

# ---- Use the Django backend (recommended) ---------------------------------
# Base URL of the Django service, as seen from the Next.js server. When set:
#   * server-rendered pages read from Django instead of public/data/
#   * /api/, /media/ and /admin/ are proxied to Django (same-origin, no CORS)
#   * the "Check for new images" button needs a staff login at /admin/
#
FLOODWATCH_API_URL=https://floodcastradar-edd2e71135a9.herokuapp.com
# Local Django instead (python manage.py runserver):
# FLOODWATCH_API_URL=http://127.0.0.1:8000

# ---- Offline demo (no backend) --------------------------------------------
# FLOODWATCH_DEMO=true

# ---- Alternative: browser calls Django directly ---------------------------
# Only if the frontend is hosted where it cannot proxy. Requires the backend's
# CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS to include this site.
# Set FLOODWATCH_API_URL as well so server-rendered pages use the same data.
#
# NEXT_PUBLIC_API_BASE=https://floodwatch-backend.example.org
